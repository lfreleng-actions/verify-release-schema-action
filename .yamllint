---
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2025 The Linux Foundation

extends: default

# Schemas imported unedited from lfit/releng-global-jjb (see
# schemas/README.md). Reformatting them would break their recorded
# digests and their comparability with the source, so they are linted
# where they were written, not here.
ignore: |
  schemas/release-artifact-schema.yaml
  schemas/release-container-schema.yaml
  schemas/release-packagecloud-schema.yaml
  schemas/release-pypi-schema.yaml
  schemas/release-schema.yaml

rules:
  empty-lines:
    max-end: 1
  comments:
    # prettier forces 1 space comment separator
    min-spaces-from-content: 1
    level: error
